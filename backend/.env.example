# ----------------------------------------------------------------------
# ThyroidAI RAG configuration
# No API key, no cloud provider, no secret is required for any of this.
# ----------------------------------------------------------------------

RAG_ENABLED=true

RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

RAG_TOP_K_VECTOR=10
RAG_TOP_K_BM25=10
RAG_RRF_K=60
RAG_TOP_K_FINAL=5
RAG_MMR_LAMBDA=0.5

RAG_CHUNK_TOKEN_SIZE=650
RAG_CHUNK_TOKEN_OVERLAP=80

# Local LLM via Ollama -- Ollama runs as its own process on the host
# (or its own container), NOT inside the backend container. No API key.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.2

# Optional: override where the persistent vector store lives.
# RAG_VECTORSTORE_DIR=/app/rag/vectorstore
